// Amity Art's — full data model (retail B2C + wholesale B2B, India-first)
// Conventions: cuid ids, Decimal(12,2) INR money, createdAt/updatedAt everywhere,
// soft-delete (deletedAt) only on User/Category/Product/ProductVariant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  SUPER_ADMIN
  MANAGER
  WHOLESALER
  CUSTOMER
}

enum WholesalerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum ChannelVisibility {
  RETAIL
  WHOLESALE
  BOTH
}

enum MediaType {
  IMAGE
  VIDEO
  IMAGE_360
  MODEL_3D
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderChannel {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  COD
  PAY_LATER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  FAILED
  OVERDUE
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementReason {
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN_RESTOCK
  PURCHASE_INWARD
  MANUAL_ADJUSTMENT
  DAMAGE
  CORRECTION
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  WHOLESALE_APPROVAL
  PAYMENT_DUE
  SYSTEM
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  HERO_CAROUSEL
  CATEGORY_GRID
  PRODUCT_RAIL
  BANNER_STRIP
  TESTIMONIALS
  BLOG_RAIL
  CUSTOM_HTML
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  DISABLED
}

enum LoyaltyReason {
  ORDER_EARN
  ORDER_REDEEM
  REFERRAL_BONUS
  SIGNUP_BONUS
  MANUAL_ADJUSTMENT
  EXPIRY
}

// ──────────────────────── Identity & Auth ────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  firstName       String
  lastName        String?
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  avatarUrl       String?

  loyaltyPoints Int     @default(0)
  referralCode  String  @unique
  referredById  String?
  referredBy    User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]  @relation("Referrals")

  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wholesalerProfile   WholesalerProfile?  @relation("WholesalerUser")
  approvedWholesalers WholesalerProfile[] @relation("WholesalerApprover")
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  statusChanges       OrderStatusHistory[]
  wishlistItems       WishlistItem[]
  reviews             Review[]             @relation("ReviewAuthor")
  moderatedReviews    Review[]             @relation("ReviewModerator")
  recentlyViewed      RecentlyViewed[]
  couponRedemptions   CouponRedemption[]
  notifications       Notification[]
  loyaltyTransactions LoyaltyTransaction[]
  stockMovements      StockMovement[]
  whatsappMessages    WhatsAppMessageLog[]
  purchasedGiftCards  GiftCard[]
  blogPosts           BlogPost[]
  updatedSettings     SiteSetting[]
  verificationTokens  VerificationToken[]

  @@index([role, isActive])
}

model WholesalerProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation("WholesalerUser", fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  gstin           String?          @unique
  panNumber       String?
  businessAddress Json?
  status          WholesalerStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?            @relation("WholesalerApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  creditLimit     Decimal          @default(0) @db.Decimal(12, 2)
  creditDays      Int              @default(0)
  creditUsed      Decimal          @default(0) @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
}

// One row per session; doubles as device/session management.
model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent         String?
  ip                String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Email verification + password reset tokens (hashed at rest).
model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // "EMAIL_VERIFY" | "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "product.update"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ─────────────────────────── Catalog ───────────────────────────

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[] @relation("CategoryTree")
  path            String // "/jewellery/earrings/jhumkas/" — derived cache
  depth           Int        @default(0)
  sortOrder       Int        @default(0)
  imageUrl        String?
  isActive        Boolean    @default(true)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([path])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  sku              String            @unique
  barcode          String?           @unique
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  gender           Gender            @default(UNISEX)
  occasion         String[]
  shortDescription String?
  description      String?           @db.Text
  material         String? // "Brass, 18k gold plated"
  hsnCode          String? // GST HSN code
  weightGrams      Decimal?          @db.Decimal(8, 2)
  // Pricing (base — variants may override)
  retailPrice      Decimal           @db.Decimal(12, 2)
  wholesalePrice   Decimal?          @db.Decimal(12, 2) // null = not sold wholesale
  compareAtPrice   Decimal?          @db.Decimal(12, 2) // strike-through MRP
  discountType     DiscountType?
  discountValue    Decimal?          @db.Decimal(12, 2)
  taxRatePercent   Decimal           @default(3) @db.Decimal(5, 2)
  // Inventory
  hasVariants      Boolean           @default(false)
  stockQty         Int               @default(0) // authoritative if !hasVariants, else rollup cache
  lowStockAlert    Int               @default(5)
  // Order rules
  minOrderQty      Int               @default(1)
  maxOrderQty      Int?
  moqWholesale     Int               @default(1) // MOQ across the size matrix
  packSize         Int               @default(1) // wholesale multiples
  // Flags
  isActive         Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  isTrending       Boolean           @default(false)
  isNewArrival     Boolean           @default(false)
  isBestSeller     Boolean           @default(false)
  visibility       ChannelVisibility @default(BOTH)
  // SEO
  metaTitle        String?
  metaDescription  String?
  searchKeywords   String[]
  // Denormalized stats
  avgRating        Decimal           @default(0) @db.Decimal(3, 2)
  reviewCount      Int               @default(0)
  soldCount        Int               @default(0)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  media          ProductMedia[]
  variants       ProductVariant[]
  collections    ProductCollection[]
  priceTiers     PriceTier[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  recentlyViewed RecentlyViewed[]

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@index([isActive, isTrending])
  @@index([isActive, isNewArrival])
  @@index([isActive, isBestSeller])
  @@index([retailPrice])
  @@index([createdAt])
}

model ProductMedia {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type         MediaType
  url          String
  thumbnailUrl String?
  altText      String?
  sortOrder    Int             @default(0)
  frameIndex   Int? // ordering within a 360 set
  isPrimary    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([productId, type])
  @@index([variantId])
}

// "Plating", "Colour", "Stone", "Finish", "Size", "Pack Size"
model Attribute {
  id         String           @id @default(cuid())
  name       String
  code       String           @unique // "size", "plating"
  isSizeAxis Boolean          @default(false) // drives wholesale size-matrix columns
  sortOrder  Int              @default(0)
  values     AttributeValue[]
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String // "Gold", "2.4"
  code        String // "gold", "2.4"
  swatchHex   String?
  sortOrder   Int                     @default(0)
  variants    VariantAttributeValue[]

  @@unique([attributeId, code])
}

model ProductVariant {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String    @unique
  barcode         String?   @unique
  title           String // denormalized: "Gold / Ruby / 2.4"
  matrixKey       String? // denormalized: sorted non-size value codes "gold|ruby"
  combinationHash String // sorted attributeValue ids hash — uniqueness guard
  retailPrice     Decimal?  @db.Decimal(12, 2) // null = inherit product
  wholesalePrice  Decimal?  @db.Decimal(12, 2)
  weightGrams     Decimal?  @db.Decimal(8, 2)
  stockQty        Int       @default(0)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attributeValues VariantAttributeValue[]
  media           ProductMedia[]
  priceTiers      PriceTier[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]

  @@unique([productId, combinationHash])
  @@index([productId, isActive])
  @@index([productId, matrixKey])
}

model VariantAttributeValue {
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
}

// Quantity-break pricing. Exactly one of productId/variantId set (DB CHECK).
model PriceTier {
  id              String          @id @default(cuid())
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel         OrderChannel    @default(WHOLESALE)
  minQty          Int
  price           Decimal?        @db.Decimal(12, 2) // XOR discountPercent
  discountPercent Decimal?        @db.Decimal(5, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([productId, variantId, channel, minQty])
  @@index([productId, channel, minQty])
  @@index([variantId, channel, minQty])
}

// ─────────────────────────── Commerce ───────────────────────────

model Cart {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   OrderChannel @default(RETAIL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

model Order {
  id          String       @id @default(cuid())
  orderNumber String       @unique // "AA-R-2026-00042" / "AA-W-2026-00007"
  channel     OrderChannel
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      OrderStatus  @default(PENDING)

  // Money (computed at placement, immutable after)
  subtotal          Decimal @db.Decimal(12, 2)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  couponId          String?
  coupon            Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String? // snapshot
  giftCardAmount    Decimal @default(0) @db.Decimal(12, 2)
  loyaltyPointsUsed Int     @default(0)
  shippingAmount    Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount        Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal @default(0) @db.Decimal(12, 2)
  igstAmount        Decimal @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal @db.Decimal(12, 2)

  // GST context
  placeOfSupplyState String // customer state code, e.g. "27"
  isInterState       Boolean
  buyerGstin         String?

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  dueDate       DateTime? // PAY_LATER: placedAt + creditDays

  // Addresses (immutable JSON snapshots)
  shippingAddress Json
  billingAddress  Json?

  // Fulfilment
  shippingZoneId       String?
  shippingZone         ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  estimatedDeliveryMin DateTime?
  estimatedDeliveryMax DateTime?
  trackingNumber       String?
  courierName          String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  customerNote         String?
  adminNote            String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  invoice              Invoice?
  couponRedemption     CouponRedemption?
  whatsappMessages     WhatsAppMessageLog[]
  loyaltyTransactions  LoyaltyTransaction[]
  giftCardTransactions GiftCardTransaction[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([channel, status])
  @@index([paymentStatus, dueDate])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Immutable snapshots
  name               String
  sku                String
  variantTitle       String?
  attributesSnapshot Json? // [{attribute:"Size", value:"2.4"}]
  imageUrl           String?
  hsnCode            String?
  unitPrice          Decimal @db.Decimal(12, 2) // channel-correct, tier-applied, pre-tax
  quantity           Int
  discountAmount     Decimal @default(0) @db.Decimal(12, 2)
  taxRatePercent     Decimal @db.Decimal(5, 2)
  taxAmount          Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)

  reviews Review[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String? // null = system
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  gatewayResponse  Json?
  refundedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([gatewayPaymentId])
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceNumber String   @unique // "AA/26-27/0001"
  fiscalYear    String // "2026-27"
  sequence      Int
  issuedAt      DateTime @default(now())
  sellerGstin   String? // snapshot from settings
  buyerGstin    String?
  pdfUrl        String?
  irn           String? // e-invoicing ready
  qrCodeUrl     String?
  createdAt     DateTime @default(now())

  @@unique([fiscalYear, sequence])
}

// Gap-free GST numbering: incremented under row lock in the invoice txn.
model InvoiceCounter {
  fiscalYear   String @id
  lastSequence Int    @default(0)
}

model Coupon {
  id                    String            @id @default(cuid())
  code                  String            @unique // stored uppercase
  type                  CouponType
  value                 Decimal           @db.Decimal(12, 2)
  minOrderAmount        Decimal?          @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?          @db.Decimal(12, 2)
  channel               ChannelVisibility @default(BOTH)
  usageLimit            Int?
  perUserLimit          Int               @default(1)
  usedCount             Int               @default(0)
  startsAt              DateTime          @default(now())
  expiresAt             DateTime?
  firstOrderOnly        Boolean           @default(false)
  applicableCategoryIds String[]
  applicableProductIds  String[]
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountApplied Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([couponId, userId])
}

// ─────────────────────────── Customer ───────────────────────────

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressType @default(HOME)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  stateCode String // GST place-of-supply, e.g. "27"
  pincode   String
  country   String      @default("IN")
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, variantId])
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId   String?      @unique // verified purchase
  orderItem     OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating        Int // 1–5, DB CHECK
  title         String?
  comment       String?
  imageUrls     String[]
  status        ReviewStatus @default(PENDING)
  moderatedById String?
  moderatedBy   User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  adminReply    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ─────────────────────────── Inventory ───────────────────────────

// Append-only ledger; stockQty columns are authoritative, this is the audit trail.
model StockMovement {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta         Int // signed
  reason        StockMovementReason
  referenceType String? // "Order"
  referenceId   String?
  note          String?
  stockAfter    Int // running balance snapshot
  createdById   String?
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

// ─────────────────────────── Shipping ───────────────────────────

model ShippingZone {
  id           String   @id @default(cuid())
  name         String // "Local", "Metro", "Rest of India"…
  minDays      Int
  maxDays      Int
  baseRate     Decimal  @db.Decimal(12, 2)
  freeAbove    Decimal? @db.Decimal(12, 2)
  codAvailable Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pincodes PincodeZone[]
  orders   Order[]
}

// First-3-digit pincode prefix → zone (~800 rows covers India).
model PincodeZone {
  id            String       @id @default(cuid())
  pincodePrefix String       @unique
  zoneId        String
  zone          ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Config ───────────────────────────

model SiteSetting {
  key         String   @id
  value       Json
  group       String   @default("general") // admin UI grouping
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── CMS ───────────────────────────

model Banner {
  id             String    @id @default(cuid())
  title          String
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  placement      String    @default("home_hero")
  sortOrder      Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement, isActive])
}

model HomepageSection {
  id        String      @id @default(cuid())
  type      SectionType
  title     String?
  config    Json // Zod-validated at API layer
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  content         String        @db.Text
  coverImageUrl   String?
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags            String[]
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  content   String
  rating    Int?
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementBar {
  id        String    @id @default(cuid())
  text      String
  linkUrl   String?
  bgColor   String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  content         String        @db.Text
  status          PublishStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─────────────────────────── Messaging ───────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model WhatsAppMessageLog {
  id                String         @id @default(cuid())
  toPhone           String
  templateName      String
  payload           Json
  status            WhatsAppStatus @default(QUEUED)
  providerMessageId String?
  attempts          Int            @default(0)
  lastError         String?
  nextRetryAt       DateTime?
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderId])
}

// ─────────────────────────── Growth ───────────────────────────

model LoyaltyTransaction {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Int // signed
  reason       LoyaltyReason
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  balanceAfter Int
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

model GiftCard {
  id             String         @id @default(cuid())
  code           String         @unique
  initialBalance Decimal        @db.Decimal(12, 2)
  balance        Decimal        @db.Decimal(12, 2)
  status         GiftCardStatus @default(ACTIVE)
  purchasedById  String?
  purchasedBy    User?          @relation(fields: [purchasedById], references: [id], onDelete: SetNull)
  recipientEmail String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions GiftCardTransaction[]
}

model GiftCardTransaction {
  id           String   @id @default(cuid())
  giftCardId   String
  giftCard     GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount       Decimal  @db.Decimal(12, 2) // signed
  balanceAfter Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([giftCardId])
}
